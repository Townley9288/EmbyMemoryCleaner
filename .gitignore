# Emby reference DLLs are NOT redistributable.
# Each developer must place their own copy in refs/ from their Emby Server install.
# CI obtains them from Emby's official release archive (see .github/workflows/release.yml).
refs/*.dll

# Keep folder + readme
!refs/.gitkeep
!refs/README.md

# Local secrets / config
*.local
secrets.json

# Copilot personal instructions (per-developer)
.github/copilot-instructions.md

# NuGet
*.nupkg
.nuget/
packages/

# Test output
TestResults/
coverage/
